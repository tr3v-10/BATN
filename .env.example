# Select mock for offline demos or payhero for live M-Pesa STK Push
PAYMENT_PROVIDER=mock

# PayHero API credentials (server-side only)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_BASE_URL=https://backend.payhero.co.ke

# Public HTTPS backend URL and a long random callback-path secret
PUBLIC_BASE_URL=
PAYHERO_CALLBACK_SECRET=

PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional persistent SQLite file path
BATN_DB_PATH=
